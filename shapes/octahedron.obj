# Octahedron
# 6 vertices, 8 triangles
# Centered at (0,0,0), fits inside -1..1. Faces are counter-clockwise seen from outside.
v 1.000000 0.000000 0.000000
v -1.000000 0.000000 0.000000
v 0.000000 1.000000 0.000000
v 0.000000 -1.000000 0.000000
v 0.000000 0.000000 1.000000
v 0.000000 0.000000 -1.000000
f 5 1 3
f 1 6 3
f 6 2 3
f 2 5 3
f 1 5 4
f 6 1 4
