# Square pyramid
# 5 vertices, 6 triangles
# Centered at (0,0,0), fits inside -1..1. Faces are counter-clockwise seen from outside.
v -1.000000 -1.000000 1.000000
v 1.000000 -1.000000 1.000000
v 1.000000 -1.000000 -1.000000
v -1.000000 -1.000000 -1.000000
v 0.000000 1.000000 0.000000
f 1 2 5
f 2 3 5
f 3 4 5
f 4 1 5
f 1 4 3
f 1 3 2
